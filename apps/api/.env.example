API_PORT=4000
# Server only. Never put this key in VITE_* variables.
DAYTONA_API_KEY=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Copy this local API access token (not the Daytona key) to the desktop .env.
ORBIT_API_TOKEN=
ORBIT_WORKSPACE_ID=personal
DAYTONA_DESKTOP_IMAGE=daytonaio/sandbox:0.6.0
DAYTONA_WINDOWS_SNAPSHOT=windows-medium
# DAYTONA_MACOS_SNAPSHOT=macos-sequoia
DAYTONA_AUTO_STOP_MINUTES=30
DAYTONA_VNC_PORT=6080
# Optional Daytona region, API endpoint, and durable instance registry directory:
# DAYTONA_TARGET=us
# DAYTONA_API_URL=https://app.daytona.io/api
# ORBIT_DATA_DIR=.data

# debug includes fleet-refresh details; info logs every request and lifecycle action.
LOG_LEVEL=info

# Server only. Used for agent chat and tools on attached Daytona computers.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra

# Optional Claude provider. Keys can also be saved in Settings.
ANTHROPIC_API_KEY=
