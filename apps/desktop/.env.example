# Omit this or set demo to use the local prototype instead.
VITE_COMPUTER_PROVIDER=daytona
# OpenAI agents are enabled in Daytona mode. Set demo to disable real agents.
VITE_AGENT_PROVIDER=openai
VITE_API_URL=http://127.0.0.1:4000
# Local API token matching apps/api/.env ORBIT_API_TOKEN, NOT DAYTONA_API_KEY.
VITE_ORBIT_API_TOKEN=
